# local development (npm run dev); docker compose sets these itself
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_SHARED_DB=nihtan_api
#BACCARAT_DB=baccarat
#DRAGONTIGER_DB=dragontiger
#POKER_DB=poker

# the one back-office account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# signs the admin session cookie, 32+ random characters (openssl rand -hex 32)
ADMIN_SESSION_SECRET=
# true when served over https
ADMIN_SESSION_SECURE=false
