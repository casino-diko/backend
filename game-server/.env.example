# Games hosted by this process (comma separated) and their dealer ports
GAMES=baccarat,dragontiger,poker
BACCARAT_PORT=8007
DRAGONTIGER_PORT=8008
POKER_PORT=8009

# MongoDB (transactions need a replica set; a single node one is enough)
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_SHARED_DB=nihtan_api
#BACCARAT_DB=baccarat
#DRAGONTIGER_DB=dragontiger
#POKER_DB=poker

# Main redis, shared with the socket-server
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional regional redis servers
REDIS_CHINA_STATUS=false
REDIS_CHINA_HOST=
REDIS_CHINA_PORT=6379
REDIS_CHINA_PASSWORD=
REDIS_EXTRA_STATUS=false
REDIS_EXTRA_HOST=
REDIS_EXTRA_PORT=6379
REDIS_EXTRA_PASSWORD=

# Round results are POSTed here (left empty: not sent)
API_HISTORY_URL=
