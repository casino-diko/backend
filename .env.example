# docker compose settings (copy to .env)

# host ports
SOCKET_SERVER_PORT=8000
BACCARAT_PORT=8007
DRAGONTIGER_PORT=8008
POKER_PORT=8009

# set to protect redis (used by every service)
REDIS_PASSWORD=

# socket-server worker processes (empty: one per CPU)
SOCKET_SERVER_WORKERS=2

# round history endpoint of the API server (empty: not sent)
API_HISTORY_URL=

# ---- web (Next.js front-end, built from ../web, the casino-diko/web repo)
#GAME_FRONT_DIR=../web
WEB_PORT=3000
# socket-server url as seen from the players' browsers
PUBLIC_SOCKET_URL=http://localhost:8000
# required: 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# true when served over https
SESSION_SECURE=false
# vendor API for seamless wallets
VENDOR_API_URL=
# /login page to pick any user. Development only!
DEV_LOGIN=false
# the brand name until it is set on the admin's Branding page
APP_NAME=Diko

# ---- admin (back-office, built from ./admin)
ADMIN_PORT=3001
# 127.0.0.1: only reachable from this machine; 0.0.0.0 to expose it (put it behind https first)
ADMIN_BIND=127.0.0.1
ADMIN_USERNAME=admin
# required to log in
ADMIN_PASSWORD=
# required: 32+ random characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
# true when served over https
ADMIN_SESSION_SECURE=false
# the player site's public url, the base of operators' launch links
PLAYER_SITE_URL=http://localhost:3000

# ---- live video (HLS)
# url per table when game_tables.env_setting.hls is not set; placeholders {app} {game} {table} {table2} {quality}
HLS_URL_TEMPLATE=
# development: fake live streams from the hls-dev service
#COMPOSE_PROFILES=dev
#HLS_URL_TEMPLATE=http://localhost:8080/hls/{app}-{table}.m3u8
