# Copy to .env for local runs (optional, real environment variables take precedence).

# Unique name of this socket server instance (prefix of its registrations in the redis `all` hash)
APP_NAME=Server1
APP_HOST=127.0.0.1
HTTP_PORT=8000
# Number of worker processes, defaults to the CPU count
#WORKERS=2

# Forward game server events to the clients (1), or only relay credits updates (0)
SHOULD_UPDATE_AND_EMIT=1

# Socket server redis: store, socket.io adapter, socket-registrations / socket-servers channels.
# Empty password = no AUTH.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis the game servers publish to (game-servers channel); defaults to the REDIS_* values
#GAME_SERVER_REDIS_HOST=127.0.0.1
#GAME_SERVER_REDIS_PORT=6379
#GAME_SERVER_REDIS_PASSWORD=
